                        "interface": "public\\s+interface\\s+([A-Z]\\w*)",
                        "extends": "(extends|implements)\\s+([\\w<&gt;,\\s]+)",
                        "autowired": "@Autowired\\s+(?:private|protected|public)?\\s*([A-Z]\\w*)",
                        "value": "@Value\\s*\\(\\s*\"([^\"]+)\"\\s*\\)",
                        "param_class": "\\b([A-Z]\\w*)\\b",
