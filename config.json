                        "new": "\\b([A-Z][A-Za-z0-9_]*)\\s+[a-zA-Z_][A-Za-z0-9_]*\\s*=\\s*new\\s+([A-Z][A-Za-z0-9_]*)\\s*\\(",
                        "throw_new": "throw\\s+new\\s+([A-Z][A-Za-z0-9_]*)",
                        "throws_pattern": "\\bthrows\\s+([A-Z][A-Za-z0-9_,\\s]+)",
                        "return_type": "(public|private|protected)\\s+([\\w<>]+)\\s+\\w+\\s*\\(",
                        "return_declaration": "^\\s*(?:public|protected|private)?\\s*(?:static\\s+)?([A-Z][A-Za-z0-9_]*)\\s+\\w+\\s*\\(",
                        "field_declaration": "\\b(?:private|protected|public)\\s+([A-Z][A-Za-z0-9_<>?,\\s]+)\\s+[a-zA-Z0-9_]+\\s*;",
                        "class_name": "public\\s+(class|interface)\\s+([A-Z]\\w*)",
                        "package": "^\\s*package\\s+([A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)*)\\s*;",
                        "import_static": "^\\s*import\\s+(?:static\\s+)?(com\\.[\\w\\.\\*]+)\\s*;",
                        "static_import": "import\\s+static\\s+([\\w\\.]+)(?:\\.\\*|\\.([\\w]+))?;",
                        "autowired_field": "@(?:Autowired|Inject)\\s*(?:\\r?\\n\\s*)*(?:private|protected|public)?\\s*(?:final\\s*)?([A-Za-z_][\\w&amp;lt;&amp;gt;\\.\\[\\]]+)\\s+([A-Za-z_]\\w+)\\s*[;=]?",
                        "variable_declaration": "\\b([A-Z][A-Za-z0-9_]*(?:\\s*&lt;[^&gt;]+&gt;)?(?:\\[\\])?)\\s+([a-z_][A-Za-z0-9_]*)\\s*(?==|;|,|\\))",                   
                        "re_var_decl": "\\b([A-Za-z_][\\w&lt;&gt;\\.\\[\\], ?]+)\\s+([A-Za-z_]\\w+)\\s*(?==|;|,|\\))",
                        "re_var_new": "\\b([A-Za-z_]\\w+)\\s*=\\s*new\\s+([A-Za-z_][\\w\\.]+)\\s*\\(",
                        "re_simple_call": "\\b(?!return\\b|this\\b|super\\b|new\\b)([A-Za-z_]\\w*)\\s*\\.\\s*([A-Za-z_]\\w*)\\s*\\(",
                        "re_member_access": "\\b(?!return\\b|this\\b|super\\b|new\\b)([A-Za-z_]\\w*)\\s*\\.\\s*([A-Za-z_]\\w+)\\b",
                        "re_unqualified_call": "(?<!\\.)\\b([A-Za-z_]\\w*)\\s*\\(",
                        "re_chain": "\\b(?!return\\b|this\\b|super\\b|new\\b)([A-Za-z_]\\w*)((?:\\.[A-Za-z_]\\w*\\s*\\([^)]*\\))+)",
                        "class_implements": "\\bclass\\s+([A-Za-z_]\\w*)\\s+implements\\b",
                        "class_declaration": "\\bclass\\s+([A-Za-z_]\\w*)\\b",
                        "interface_declaration": "\\binterface\\s+([A-Za-z_]\\w*)\\b",
                        "method_call": "\\.([A-Za-z_]\\w*)\\s*\\(",
                        "var_decl_pattern": "(?:private|protected|public|final|static)?\\s*([\\w&lt;&gt;]+)\\s+(\\w+)\\s*(?:=|;)",
                        "for_loop_pattern": "for\\s*\\(\\s*(?:final\\s+)?([\\w&lt;&gt;]+)\\s+(\\w+)\\s*[:].*?\\)",
                        "method_pattern": "(?:public|private|protected|\\s)*(?:static\\s+)?[&lt;&gt;\\w\\[\\],\\s]+\\s+METHOD_NAME\\s*\\([^)]*\\)\\s*\\{",
                        "dot_segment_pat": "\\.\\s*([A-Za-z_]\\w*)\\s*\\(",
                        "fallback_unqualified_call": "(?<!\\.)\\b([A-Za-z_]\\w*)\\s*\\(",
                        "fallback_qualified_call": "\\b(?!return\\b|this\\b|super\\b|new\\b)[A-Za-z_]\\w*\\s*\\.\\s*[A-Za-z_]\\w*\\s*\\(",
                        "method_param_decl": "(?:@\\w+(?:\\([^)]*\\))?\\s+)*(?:final\\s+)?([A-Za-z_]\\w*(?:\\s*&lt;[^&gt;]+&gt;)?(?:\\[\\])?)\\s+([A-Za-z_]\\w*)"
                    }
  
